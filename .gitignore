.raycast/scripts/Redash-*.sh
.raycast/scripts/Lark-*.sh
.raycast/scripts/Grafana-*.sh
.raycast/scripts/Aliyun-*.sh
.raycast/scripts/Gitlab-*.sh
.raycast/scripts/Nacos-*.sh

# Python bytecode and tool caches
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local zsh history; configuration is tracked separately.
.zsh_history
.zsh_history.*

# Local login configuration and externally managed tmux entry point.
/.zprofile
/.tmux.conf

# Local deployment tools: never track or force-add these files.
/.zsh/functions/deploy.zsh
/.zsh/scripts/gitlab_publish_k8s.py

# Local verification tools and generated Kitty theme selection.
/.config/alfred/themes/tests/
/.config/tmux/tests/
/.config/kitty/current-theme.conf

# macOS metadata
.DS_Store

# Editor temporary files
*.swp
*.swo
*~

# Rime links and migration backups are created locally by install.sh.
/Library/Rime
/Library/Rime.backup.*/
