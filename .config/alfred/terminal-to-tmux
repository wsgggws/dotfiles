#!/bin/bash
set -euo pipefail

session=${ALFRED_TMUX_SESSION:-S0}
window_name=${ALFRED_TMUX_WINDOW:-deploy}
tmux=/opt/homebrew/bin/tmux
wezterm=/opt/homebrew/bin/wezterm
command=${1-}

if ! "$tmux" has-session -t "=$session" 2>/dev/null; then
  echo "tmux session not found: $session" >&2
  exit 1
fi

client_ttys=$("$tmux" list-clients -t "$session" -F '#{client_tty}')
wezterm_pane_id=$("$wezterm" cli list --format json | /usr/bin/ruby -rjson -e '
  ttys = ARGV.fetch(0).lines.map(&:strip)
  pane = JSON.parse(STDIN.read).find { |item| ttys.include?(item["tty_name"]) }
  print pane["pane_id"] if pane
' "$client_ttys")
if [[ -z "$wezterm_pane_id" ]]; then
  echo "No WezTerm pane is attached to tmux session: $session" >&2
  exit 1
fi

window_id=
while IFS=' ' read -r id name; do
  if [[ "$name" == "$window_name" ]]; then
    if [[ -n "$window_id" ]]; then
      echo "Multiple tmux windows named $window_name in session $session" >&2
      exit 1
    fi
    window_id=$id
  fi
done < <("$tmux" list-windows -t "$session" -F '#{window_id} #{window_name}')

if [[ -z "$window_id" ]]; then
  window_id=$("$tmux" new-window -d -t "$session:" -n "$window_name" -P -F '#{window_id}')
fi

pane_id=$("$tmux" display-message -p -t "$window_id" '#{pane_id}')
pane_command=$("$tmux" display-message -p -t "$pane_id" '#{pane_current_command}')
"$tmux" select-window -t "$window_id"
/usr/bin/open -a WezTerm
"$wezterm" cli activate-pane --pane-id "$wezterm_pane_id"

if [[ -n "$command" ]]; then
  # Reuse the existing window without replacing its foreground program.
  case "$pane_command" in
    bash|-bash|fish|-fish|sh|-sh|zsh|-zsh) ;;
    *) echo "Window $window_name is running $pane_command; focused it without sending a command" >&2; exit 1 ;;
  esac
  if [[ $("$tmux" display-message -p -t "$pane_id" '#{pane_in_mode}') != 0 ]]; then
    echo "Window $window_name is in copy mode; focused it without sending a command" >&2
    exit 1
  fi
  # Clear a pending shell line before inserting the requested command.
  "$tmux" send-keys -t "$pane_id" C-c
  sleep 0.2
  "$tmux" send-keys -t "$pane_id" -l -- "$command"
  "$tmux" send-keys -t "$pane_id" Enter
fi
