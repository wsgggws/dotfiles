[delta "luzhu"]
    dark = true
    light = false
    syntax-theme = LuZhu
    minus-style = syntax "#432F2B"
    minus-emph-style = "#182A22" bold "#D29580"
    plus-style = syntax "#294630"
    plus-emph-style = "#DCE8D5" bold "#41634A"
    file-style = bold "#99CEBE"
    file-decoration-style = "#56785D" ul
    hunk-header-style = syntax file line-number
    hunk-header-decoration-style = "#56785D" box
    zero-style = syntax "#1D3229"
    line-numbers-left-style = "#A6A5A2" "#1D3229"
    line-numbers-right-style = "#A6A5A2" "#1D3229"
    line-numbers-zero-style = "#A6A5A2" "#1D3229"
    line-numbers-minus-style = "#D29580" "#432F2B"
    line-numbers-plus-style = "#A8C38B" "#294630"
