[core]
        quotepath = false
        autocrlf = input
	hooksPath = /Users/thj/.githooks
        pager = delta
[user]
        name = wsgggws
        email = wsgggws@gmail.com

[column]
        ui = auto
[branch]
        sort = -committerdate
[tag]
        sort = version:refname
[init]
        defaultBranch = main
[diff]
        algorithm = histogram
        colorMoved = zebra
        colorMovedWS = allow-indentation-change
        mnemonicPrefix = true
	tool = nvimdiff
	wsErrorHighlight = all
[push]
        autoSetupRemote = true
        followTags = true
        useForceIfIncludes = true
[fetch]
        prune = true
        writeCommitGraph = true

[help]
        autocorrect = prompt
[commit]
        verbose = true
[rerere]
        enabled = true
[rebase]
        autoSquash = true
        autoStash = true
        updateRefs = true
        missingCommitsCheck = error

[pull]
        rebase = true

[alias]
        lg = log --color --graph --pretty=format:'%C(auto)%h%C(reset) -%C(bold blue)%d%C(reset) %s %C(dim white)- %an, %ar%C(reset)' --abbrev-commit
        lgg = log --color --graph --all --pretty=format:'%C(auto)%h%C(reset) -%C(bold blue)%d%C(reset) %s %C(dim white)- %an, %ar%C(reset)' --abbrev-commit
        lgs = log --color --graph --pretty=format:'%C(auto)%h%C(reset) %Cgreen%ad%Creset %C(bold blue)%d%C(reset) %C(bold white)%s%C(reset) %C(dim cyan)[%an]%C(reset)' --date=short
        lol = log --graph --decorate --oneline
        hist = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate
	clean-branches = "!f() { current=$(git branch --show-current) || exit; test -n \"$current\" || { echo \"Not on a branch\" >&2; exit 1; }; git for-each-ref --merged=HEAD --format='%(refname:short)' refs/heads | while IFS= read -r branch; do case \"$branch\" in \"$current\"|main|master|develop|development) continue ;; esac; git branch -d -- \"$branch\"; done; }; f"

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
    true-color = always
    wrap-max-lines = 0

    # Original Dracula configuration (inactive)
    # dark = true
    # syntax-theme = Dracula
    # minus-style = syntax "#3c2632"
    # minus-emph-style = syntax bold "#7a3045"
    # plus-style = syntax "#243b32"
    # plus-emph-style = syntax bold "#245f45"
    # file-style = bold "#8be9fd"
    # file-decoration-style = "#6272a4" ul
    # hunk-header-style = syntax file line-number
    # hunk-header-decoration-style = "#6272a4" box
    # zero-style = syntax "#282a36"
    # line-numbers-left-style = "#6272a4" "#282a36"
    # line-numbers-right-style = "#6272a4" "#282a36"
    # line-numbers-zero-style = "#6272a4" "#282a36"
    # line-numbers-minus-style = "#ff5555" "#3c2632"
    # line-numbers-plus-style = "#50fa7b" "#243b32"

    # Sheepskin Light (active)
    light = true
    syntax-theme = SheepskinLight
    minus-style = syntax "#c39c87"
    minus-emph-style = "#252219" bold "#b88973"
    plus-style = syntax "#adb87f"
    plus-emph-style = "#252219" bold "#94aa70"
    file-style = bold "#234861"
    file-decoration-style = "#234861" ul
    hunk-header-style = syntax file line-number
    hunk-header-decoration-style = "#987d48" box
    zero-style = syntax "#cdb06a"
    line-numbers-left-style = "#987d48" "#cdb06a"
    line-numbers-right-style = "#987d48" "#cdb06a"
    line-numbers-zero-style = "#615a43" "#cdb06a"
    line-numbers-minus-style = "#7d2925" "#c39c87"
    line-numbers-plus-style = "#2d4824" "#adb87f"

    # Catppuccin Mocha (inactive)
    # dark = true
    # syntax-theme = Catppuccin Mocha
    # minus-style = syntax "#3a2730"
    # minus-emph-style = syntax bold "#6d354a"
    # plus-style = syntax "#293b35"
    # plus-emph-style = syntax bold "#2d5c4a"
    # file-style = bold "#89b4fa"
    # file-decoration-style = "#585b70" ul
    # hunk-header-style = syntax file line-number
    # hunk-header-decoration-style = "#585b70" box
    # zero-style = syntax "#1e1e2e"
    # line-numbers-left-style = "#585b70" "#1e1e2e"
    # line-numbers-right-style = "#585b70" "#1e1e2e"
    # line-numbers-zero-style = "#a6adc8" "#1e1e2e"
    # line-numbers-minus-style = "#f38ba8" "#3a2730"
    # line-numbers-plus-style = "#a6e3a1" "#293b35"

[difftool]
    prompt = false

[color "diff"]
    whitespace = red reverse

[merge]
    conflictStyle = zdiff3
